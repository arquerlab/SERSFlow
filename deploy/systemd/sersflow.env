# SERSFlow environment — install as /etc/sersflow/sersflow.env
# Paths: application /opt/sersflow, data /var/lib/sersflow (PCES01)

SERSFLOW_HOST=0.0.0.0
SERSFLOW_PORT=8000

SERSFLOW_DB_PATH=/var/lib/sersflow/sersflow.db
SERSFLOW_UPLOAD_DIR=/var/lib/sersflow/uploads
SERSFLOW_DATA_DIR=/var/lib/sersflow/data
SERSFLOW_ARTIFACTS_DIR=/var/lib/sersflow/artifacts

SERSFLOW_RELOAD=0
